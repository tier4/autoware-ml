### Every setting is an absolute host path.

### [Required] For Docker container, this path is mounted at the same path as on the host.

# Root of the datasets. Docker mounts it read only.
AUTOWARE_ML_DATA_PATH=

### [Optional] For Docker container, these paths are mounted at the same paths as on the host.

# External configs, laid out like autoware_ml/configs/.
AUTOWARE_ML_CONFIGS_PATH=

# Root of the scenario lists of custom databases.
AUTOWARE_ML_SCENARIOS_PATH=

# Root of the experiment outputs, uses project root if not set.
AUTOWARE_ML_WORKING_DIR=
